<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報アプリ"
        Height="480"
        Width="795">

    <Grid Margin="20">

        <StackPanel>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">

                <TextBlock Text="場所："
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

                <ComboBox x:Name="PlaceComboBox"
                      Width="150"
                      SelectionChanged="PlaceComboBox_SelectionChanged">

                    <ComboBoxItem Content="東京"/>
                    <ComboBoxItem Content="大阪"/>
                    <ComboBoxItem Content="名古屋"/>
                    <ComboBoxItem Content="札幌"/>
                    <ComboBoxItem Content="福岡"/>

                </ComboBox>

            </StackPanel>

            <TabControl>

                <TabItem Header="現在の天気">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock x:Name="DateTimeText"
                           FontSize="16"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                        <TextBlock x:Name="TitleText"
                           Text="現在の東京の天気"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>


                        <TextBlock x:Name="WeatherIconText"
                           FontSize="64"
                           Margin="0,10"/>

                    <TextBlock x:Name="TemperatureText"
                           FontSize="32"
                           FontWeight="Bold"/>

                    <TextBlock x:Name="WeatherText"
                           FontSize="20"/>

                    <TextBlock x:Name="HumidityText"
                           FontSize="18"/>

                    <TextBlock x:Name="WindText"
                           FontSize="18"/>

                </StackPanel>

            </TabItem>
            <TabItem Header="週間予報">

                <Grid Margin="10">

                    <ListView x:Name="ForecastListView">

                        <ListView.View>
                            <GridView>

                                <GridViewColumn Header="日付"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Date}" />

                                <GridViewColumn Header="天気"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Weather}" />

                                <GridViewColumn Header="気温"
                                    Width="150"
                                    DisplayMemberBinding="{Binding Temperature}" />

                                <GridViewColumn Header="降水確率"
                                    Width="100"
                                    DisplayMemberBinding="{Binding PrecipitationProbability}" />

                            </GridView>

                        </ListView.View>

                    </ListView>

                </Grid>

            </TabItem>

            </TabControl>

        </StackPanel>

    </Grid>
</Window>